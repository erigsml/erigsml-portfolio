---
/**
 * El cielo fijo detrás de toda la página. Three.js se carga cuando el
 * navegador está libre, así el texto aparece primero; mientras tanto se ve
 * un degradado con los mismos azules.
 */
---

<div class="cielo" id="cielo" aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  const host = document.getElementById('cielo');
  if (host) {
    const start = () =>
      import('../scripts/aurero/index').then(({ mount }) =>
        mount(host, {
          clickArea: document.getElementById('inicio'),
          windows: [document.getElementById('inicio'), document.getElementById('contacto')],
        }),
      );
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
    else setTimeout(start, 300);
  }
</script>

<style>
  .cielo {
    position: fixed;
    inset: 0;
    z-index: 0;
    /* Los mismos azules del cielo mientras carga Three.js. */
    background:
      radial-gradient(50% 45% at 22% 45%, #eaf2fd 0%, rgba(234, 242, 253, 0) 60%),
      radial-gradient(120% 90% at 55% 45%, #2f62b4 0%, #3a6cbc 45%, #6d93cc 80%, #a9c2e6 100%);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  canvas:global(.listo) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    canvas { transition: none; }
  }
</style>
