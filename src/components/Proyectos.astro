---
/**
 * Proyectos en orden de importancia. Los destacados ocupan una fila completa cada uno
 * (el #01, más grande); el resto va abajo como índice compacto de ficha + foto.
 */
import { Image } from 'astro:assets';
import { destacados, otros } from '../data/projects';
import Tiendas from './Tiendas.astro';
import Tecnologias from './Tecnologias.astro';

const total = destacados.length + otros.reduce((n, g) => n + g.projects.length, 0);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="proyectos" id="proyectos" aria-labelledby="proyectos-titulo">
  <header class="cabecera">
    <h2 id="proyectos-titulo">Proyectos destacados</h2>
    <p class="lema">Lo que he construido, de lo que más pesa a lo que menos:{' '}<br />apps publicadas, software en producción e IA que no inventa.</p>
    <p class="cuenta">{pad(destacados.length)} destacados · {total} en total</p>
  </header>

  <ol class="destacados">
    {
      destacados.map((p, i) => (
        <li class:list={['destacado', { primero: i === 0 }]} data-reveal aria-labelledby={`d-${i}`}>
          <div class="ficha">
            <p class="cod">{pad(i + 1)}</p>
            <h3 id={`d-${i}`}>{p.name}</h3>
            {p.role && <p class="rol">{p.role}</p>}
            {p.logro && <p class="logro">{p.logro}</p>}
            <p class="desc">{p.blurb}</p>
            <div class="tags"><Tecnologias items={p.stack} /></div>
            {p.note && <p class="nota">{p.note}</p>}
            {p.stores && <div class="tiendas"><Tiendas app={p.name} {...p.stores} /></div>}
            {p.url && (
              <a class="ver" href={p.url} target="_blank" rel="noopener">
                {p.urlLabel ?? 'Sitio web'} ↗<span class="visually-hidden"> de {p.name}</span>
              </a>
            )}
          </div>
          <figure class:list={['toma', { logo: p.logoBg }]} style={p.logoBg ? `--toma-bg:${p.logoBg}` : undefined}>
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <Image src={p.image} alt="" widths={[720, 1080, 1600]} sizes="(min-width: 1000px) 60vw, 100vw" loading="lazy" decoding="async" />
              </a>
            ) : (
              <Image src={p.image} alt={p.alt} widths={[720, 1080, 1600]} sizes="(min-width: 1000px) 60vw, 100vw" loading="lazy" decoding="async" />
            )}
          </figure>
        </li>
      ))
    }
  </ol>

  <header class="cabecera otros-cab">
    <h2>Otros proyectos</h2>
    <p class="lema">Más trabajo para clientes: sitios, catálogos y medios digitales.</p>
    <p class="cuenta">{total - destacados.length} proyectos</p>
  </header>

  {
    otros.map((g, gi) => (
      <section class="grupo" aria-labelledby={`g-${g.id}`}>
        <h3 class="grupo-titulo" id={`g-${g.id}`}>{g.title}</h3>
        <div class="indice">
          {g.projects.map((p, pi) => (
            <article class="proyecto" data-reveal>
              <div class="ficha">
                <p class="cod">{`${gi + 1}.${pi + 1}`}</p>
                <h4>{p.name}</h4>
                <p class="cat">{p.kind}</p>
                <p class="desc">{p.blurb}</p>
                <div class="stack"><Tecnologias items={p.stack} size="chico" /></div>
                {p.url && (
                  <a class="ver" href={p.url} target="_blank" rel="noopener">
                    {p.urlLabel ?? 'ver sitio'} ↗<span class="visually-hidden"> de {p.name}</span>
                  </a>
                )}
              </div>
              <figure class="toma">
                {p.url ? (
                  <a href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                    <Image src={p.image} alt="" widths={[320, 480, 720]} sizes="(min-width: 1000px) 16vw, (min-width: 640px) 25vw, 100vw" loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <Image src={p.image} alt={p.alt} widths={[320, 480, 720]} sizes="(min-width: 1000px) 16vw, (min-width: 640px) 25vw, 100vw" loading="lazy" decoding="async" />
                )}
              </figure>
            </article>
          ))}
        </div>
      </section>
    ))
  }
</section>

<script>
  // Los proyectos (y el resto de bloques con data-reveal) aparecen suavemente al entrar en pantalla.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('visto');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -6% 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('visto'));
  }
</script>

<style>
  .proyectos {
    --gap: clamp(16px, 3.3vw, 48px);
    position: relative;
    z-index: 1;
    background: var(--paper);
    color: var(--paper-ink);
    padding-block: 32px 160px;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    font-family: var(--f-mono);
    font-size: 13px;
    line-height: 1.5;
    transition: background-color 1.2s ease, color 1.2s ease;
  }
  p { margin: 0; }

  .cabecera {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 16px;
    margin-bottom: clamp(80px, 11vw, 150px);
  }
  .cabecera h2 { margin: 0; font-size: 13px; font-weight: 400; }
  .lema { text-align: center; }
  .cuenta { text-align: right; color: var(--paper-soft); }
  .otros-cab {
    margin-top: clamp(120px, 14vw, 200px);
    margin-bottom: clamp(48px, 7vw, 96px);
    padding-top: clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--paper-shade);
  }

  /* ---------- Destacados: una fila por proyecto, 6 columnas (ficha 3 + foto 3). ---------- */
  .destacados {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    row-gap: clamp(72px, 9vw, 140px);
  }
  .destacado {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
  }
  .destacado .ficha { grid-column: span 3; padding-right: 8%; }
  .destacado .toma { grid-column: span 3; aspect-ratio: 16 / 10; }
  /* El #01 manda: título enorme y foto de 4 columnas. */
  .primero .ficha { grid-column: span 2; }
  .primero .toma { grid-column: span 4; aspect-ratio: 16 / 9; }

  .ficha { display: flex; flex-direction: column; min-width: 0; }
  .cod { color: var(--paper-soft); font-size: 11px; margin-bottom: 14px; font-variant-numeric: tabular-nums; }
  .destacado .cod {
    font-family: var(--f-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--paper-ink);
    padding-bottom: 10px;
    border-bottom: 1px solid currentColor;
    margin-bottom: 20px;
  }
  .destacado h3 {
    margin: 0 0 8px;
    font-family: var(--f-display);
    font-size: clamp(30px, 3.4vw, 48px);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .primero h3 { font-size: clamp(44px, 5.4vw, 80px); line-height: 0.9; }
  .cat { color: var(--paper-ink); }
  .rol { margin-top: 2px; color: var(--paper-soft); }
  /* Sello de logro: borde fino, como un timbre sobre el papel. */
  .logro {
    align-self: flex-start;
    margin-top: 14px;
    padding: 3px 8px;
    border: 1px solid currentColor;
    border-radius: 2px;
    color: var(--pen);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .desc { margin-top: 24px; max-width: 46ch; }
  .destacado .desc { font-size: 15px; }
  .tags { margin-top: 18px; max-width: 52ch; }
  .stack { margin-top: 14px; }
  .nota {
    margin-top: 18px;
    font-family: var(--f-hand);
    font-size: 23px;
    line-height: 1.05;
    color: var(--pen);
    transform: rotate(-2deg);
    transform-origin: left center;
  }
  .tiendas { margin-top: 24px; }
  .ver {
    align-self: flex-start;
    margin-top: 10px;
    padding: 10px 0;
    color: var(--paper-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .ver:hover { color: var(--pen); }

  /* ---------- Otros: índice compacto, 3 por fila (ficha + foto). ---------- */
  .grupo + .grupo { margin-top: clamp(64px, 8vw, 120px); }
  .grupo-titulo {
    margin: 0 0 32px;
    font-size: 13px;
    font-weight: 400;
    color: var(--paper-soft);
  }
  .indice {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(48px, 6vw, 88px);
    align-items: start;
  }
  .proyecto {
    grid-column: span 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
    min-width: 0;
  }
  h4 { margin: 0; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; }
  .proyecto .cat { color: var(--paper-soft); }
  .proyecto .desc { max-width: 34ch; }

  /* Foto: al pasar el cursor se agranda un poco, sin marco ni sombra. */
  .toma {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--toma-bg, var(--paper-shade));
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-origin: center;
  }
  .toma a { display: block; height: 100%; }
  .toma :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  /* Un logo se ve completo y centrado, con aire alrededor. */
  .logo :global(img) { object-fit: contain; object-position: center; padding: 10% 14%; }
  .proyecto:hover .toma { transform: scale(1.12); z-index: 2; }
  .destacado:hover .toma { transform: scale(1.02); }

  @media (max-width: 1000px) {
    .destacado { grid-template-columns: minmax(0, 1fr); row-gap: 32px; }
    .destacado .ficha, .primero .ficha { grid-column: 1 / -1; padding-right: 0; }
    .destacado .toma, .primero .toma { grid-column: 1 / -1; }
    .indice { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .cabecera { grid-template-columns: 1fr 1fr; }
    .lema { grid-column: 1 / -1; grid-row: 2; text-align: left; }
    .lema br { display: none; }
    .indice { grid-template-columns: minmax(0, 1fr); row-gap: 56px; }
    .proyecto { grid-column: auto; grid-template-columns: minmax(0, 1fr); row-gap: 20px; }
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .proyecto:hover .toma, .destacado:hover .toma { transform: none; }
  }

  /* Aparición: solo con JavaScript y si no se pidió menos movimiento. */
  :global(.js) [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.js) [data-reveal]:global(.visto) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
