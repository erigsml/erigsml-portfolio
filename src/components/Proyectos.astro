---
/**
 * Índice de proyectos sin tarjetas. Cada proyecto es un bloque de dos celdas
 * (ficha + foto) que nunca se separa; el principal ocupa una fila completa.
 */
import { Image } from 'astro:assets';
import { groups } from '../data/projects';
import Tiendas from './Tiendas.astro';

const items = groups.flatMap((g, gi) =>
  g.projects.map((p, pi) => ({ p, code: `${gi + 1}.${pi + 1}`, label: g.title })),
);
---

<section class="proyectos" id="proyectos" aria-labelledby="proyectos-titulo">
  <header class="cabecera">
    <h2 id="proyectos-titulo">Proyectos</h2>
    <p class="lema">Software que la gente usa: apps, sistemas para negocios{' '}<br />e IA que no se inventa los números.</p>
    <p class="cuenta">{items.length} proyectos</p>
  </header>

  <div class="indice">
    {
      items.map(({ p, code, label }) => (
        <article class:list={['proyecto', { principal: p.featured }]} data-reveal aria-labelledby={`p-${code}`}>
          <div class="ficha">
            <p class="cod">{code}</p>
            <h3 id={`p-${code}`}>{p.name}</h3>
            <p class="cat">{label}</p>
            <p class="desc">{p.blurb}</p>
            <p class="stack">{p.stack.join(', ')}</p>
            {p.note && <p class="nota">{p.note}</p>}
            {p.stores && <div class="tiendas"><Tiendas app={p.name} {...p.stores} /></div>}
            {p.url && (
              <a class="ver" href={p.url} target="_blank" rel="noopener">
                ver sitio ↗<span class="visually-hidden"> de {p.name}</span>
              </a>
            )}
          </div>
          <figure class:list={['toma', { logo: p.logoBg }]} style={p.logoBg ? `--toma-bg:${p.logoBg}` : undefined}>
            {p.url ? (
              <a href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <Image
                  src={p.image}
                  alt=""
                  widths={p.featured ? [720, 1080, 1600] : [320, 480, 720]}
                  sizes={p.featured ? '(min-width: 1000px) 75vw, 100vw' : '(min-width: 1000px) 16vw, (min-width: 640px) 25vw, 100vw'}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : (
              <Image
                src={p.image}
                alt={p.alt}
                widths={[320, 480, 720]}
                sizes="(min-width: 1000px) 16vw, (min-width: 640px) 25vw, 100vw"
                loading="lazy"
                decoding="async"
              />
            )}
          </figure>
        </article>
      ))
    }
  </div>
</section>

<script>
  // Los proyectos aparecen suavemente al entrar en pantalla.
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('visto');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -6% 0px' },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('visto'));
  }
</script>

<style>
  .proyectos {
    --gap: clamp(16px, 3.3vw, 48px);
    position: relative;
    z-index: 1;
    background: var(--paper);
    color: var(--paper-ink);
    padding-block: 32px 160px;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    font-family: var(--f-mono);
    font-size: 13px;
    line-height: 1.5;
    transition: background-color 1.2s ease, color 1.2s ease;
  }

  .cabecera {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 16px;
    margin-bottom: clamp(80px, 11vw, 150px);
  }
  .cabecera h2 { margin: 0; font-size: 13px; font-weight: 400; }
  .lema { margin: 0; text-align: center; }
  .cuenta { margin: 0; text-align: right; color: var(--paper-soft); }

  /* 6 columnas; cada proyecto ocupa 2 (ficha + foto), así nunca se parte entre filas.
     La rejilla interna usa el mismo gap, por eso las celdas coinciden con las columnas de afuera. */
  .indice {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: clamp(64px, 8vw, 120px);
    align-items: start;
  }
  .proyecto {
    grid-column: span 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: start;
    min-width: 0;
  }
  .principal {
    grid-column: 1 / -1;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .principal .ficha { grid-column: span 2; padding-right: 8%; }
  .principal .toma { grid-column: span 4; }

  .ficha { display: flex; flex-direction: column; min-width: 0; }
  .ficha p { margin: 0; }
  .cod { color: var(--paper-soft); font-size: 11px; margin-bottom: 14px !important; font-variant-numeric: tabular-nums; }
  h3 {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .principal h3 {
    font-family: var(--f-display);
    font-size: clamp(40px, 5vw, 72px);
    line-height: 0.9;
    font-weight: 700;
    text-transform: none;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .desc { margin-top: 28px !important; max-width: 34ch; }
  .principal .desc { font-size: 15px; max-width: 40ch; }
  .stack { margin-top: 14px !important; color: var(--paper-soft); font-size: 12px; }
  .nota {
    margin-top: 16px !important;
    font-family: var(--f-hand);
    font-size: 21px;
    line-height: 1.05;
    color: var(--pen);
    transform: rotate(-2deg);
    transform-origin: left center;
  }
  .principal .nota { font-size: 26px; }
  .tiendas { margin-top: 24px; }
  .ver {
    align-self: flex-start;
    margin-top: 10px;
    padding: 10px 0;
    color: var(--paper-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .ver:hover { color: var(--pen); }

  /* Foto: al pasar el cursor se agranda un poco, sin marco ni sombra. */
  .toma {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    background: var(--toma-bg, var(--paper-shade));
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-origin: center;
  }
  .principal .toma { aspect-ratio: 16 / 9; }
  .toma a { display: block; height: 100%; }
  .toma :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  /* Un logo se ve completo y centrado, con aire alrededor. */
  .logo :global(img) { object-fit: contain; object-position: center; padding: 10% 14%; }
  .proyecto:hover .toma { transform: scale(1.12); z-index: 2; }
  .principal:hover .toma { transform: scale(1.025); }

  @media (max-width: 1000px) {
    .indice { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .principal { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .principal .ficha { grid-column: 1 / -1; padding-right: 0; margin-bottom: 32px; }
    .principal .toma { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .cabecera { grid-template-columns: 1fr 1fr; }
    .lema { grid-column: 1 / -1; grid-row: 2; text-align: left; }
    .lema br { display: none; }
    .indice { grid-template-columns: minmax(0, 1fr); row-gap: 56px; }
    .proyecto, .principal { grid-column: auto; grid-template-columns: minmax(0, 1fr); row-gap: 20px; }
    .proyecto:hover .toma { transform: none; }
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .proyecto:hover .toma { transform: none; }
  }

  /* Aparición: solo con JavaScript y si no se pidió menos movimiento. */
  :global(.js) [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  :global(.js) [data-reveal]:global(.visto) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
